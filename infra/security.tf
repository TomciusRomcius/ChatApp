resource "aws_security_group" "frontend" {
  vpc_id = aws_vpc.chatapp-vpc.id
  name   = "chatapp-frontend"
  ingress {
    from_port = 3000
    to_port = 3000
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }
  egress {
    from_port   = 0
    to_port     = 65535
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_security_group" "backend" {
  vpc_id = aws_vpc.chatapp-vpc.id
  name   = "chatapp-backend"
  ingress {
    from_port = 8080
    to_port = 8080
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }
  egress {
    from_port   = 0
    to_port     = 65535
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_security_group" "mssql" {
  vpc_id = aws_vpc.chatapp-vpc.id
  name   = "chatapp-backend"
  ingress {
    from_port = 1433
    to_port = 1433
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }
  egress {
    from_port   = 0
    to_port     = 65535
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
